# ==========================================
# FITBUDDY – Environment Configuration
# ==========================================

# Server Port
PORT=5000

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Database Connection (MySQL / Drizzle)
# If MySQL is not running locally, FitBuddy gracefully operates with an in-memory/fallback database for full testability.
DATABASE_URL=mysql://root:password@localhost:3306/fitbuddy

# JWT Secret for User Authentication
JWT_SECRET=fitbuddy_ultra_secure_jwt_secret_key_2026_change_in_production

# Google Gemini API Key
# If omitted or left empty, FitBuddy runs in "Demo AI Mode" with realistic AI fitness plan generation.
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model to use (default: gemini-2.5-flash or gemini-1.5-flash)
GEMINI_MODEL=gemini-2.5-flash
